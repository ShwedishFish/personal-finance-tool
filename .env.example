# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Plaid (optional). Free sandbox keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Products every linked institution must support. Use "investments" alone for brokerage-only logins.
PLAID_PRODUCTS=transactions
# Products used when the institution supports them.
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=US

# Database location (defaults to data/finance.db)
# PFT_DATABASE_URL=sqlite:////absolute/path/to/finance.db
