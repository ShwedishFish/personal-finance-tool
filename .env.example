# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Plaid (optional). Free sandbox keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Products every linked institution must support. Use "investments" alone for brokerage-only logins.
PLAID_PRODUCTS=transactions
# Products used when the institution supports them.
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=US

# Database location. Defaults to data/finance.db if that file exists (installs before 1.2), else
# finance.db in the per-user folder (macOS: ~/Library/Application Support/Personal Finance Tool).
# PFT_DATA_DIR=/absolute/path/to/folder
# PFT_DATABASE_URL=sqlite:////absolute/path/to/finance.db
# Encryption key for stored Plaid tokens (default: generated and kept in the system keychain).
# PFT_SECRET_KEY=
# Extra host names the server answers to, comma-separated (default: 127.0.0.1, localhost).
# PFT_ALLOWED_HOSTS=
